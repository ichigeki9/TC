# Lokalnie: skopiuj do .env lub ustaw w terminalu. Na Northflanku: Environment variables.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=wygeneruj-dlugi-losowy-ciag
DJANGO_ALLOWED_HOSTS=trainingculture.pl,www.trainingculture.pl,twoj-serwis.code.run
DJANGO_CSRF_TRUSTED_ORIGINS=https://trainingculture.pl,https://www.trainingculture.pl,https://twoj-serwis.code.run
# Adres bazy Postgres z addonu Northflank (bez tej zmiennej używany jest lokalny SQLite)
DATABASE_URL=postgresql://user:haslo@host:5432/baza
