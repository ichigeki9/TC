# Lokalnie: skopiuj do pliku .env (wczytuje się sam, jest w .gitignore) i ustaw DJANGO_DEBUG=1.
# Na Northflanku: Environment → Runtime variables (plik .env nie trafia na serwer).
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=wygeneruj-dlugi-losowy-ciag
DJANGO_ALLOWED_HOSTS=trainingculture.pl,www.trainingculture.pl,twoj-serwis.code.run
DJANGO_CSRF_TRUSTED_ORIGINS=https://trainingculture.pl,https://www.trainingculture.pl,https://twoj-serwis.code.run
# Adres bazy Postgres z addonu Northflank (bez tej zmiennej używany jest lokalny SQLite)
DATABASE_URL=postgresql://user:haslo@host:5432/baza
# Katalog na zdjęcia wgrywane w panelu — na Northflanku ścieżka trwałego wolumenu
DJANGO_MEDIA_ROOT=/app/media
# Poczta — Brevo (SMTP). Brevo → SMTP & API → zakładka SMTP: login i „Generate a new SMTP key”.
# EMAIL_HOST_USER to login SMTP z Brevo (nie Twój adres), EMAIL_HOST_PASSWORD to klucz SMTP.
# Bez EMAIL_HOST maile tylko wypisują się w konsoli.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=123abc001@smtp-brevo.com
EMAIL_HOST_PASSWORD=xsmtpsib-klucz-z-brevo
# Nadawca — adres potwierdzony w Brevo (Senders). Przy Brevo ustaw koniecznie, bo login SMTP nie jest adresem nadawcy.
DEFAULT_FROM_EMAIL=Training Culture <traincultpolska@gmail.com>
# Powiadomienia o opłaconych zamówieniach (domyślnie EMAIL_HOST_USER, puste = wyłączone) — przy Brevo ustaw koniecznie
SHOP_NOTIFY_EMAIL=traincultpolska@gmail.com
